# Public connection settings are embedded at build time. Rebuild after changes.
# Copy the public app key and browser-reachable host/port from your Reverb setup.
# Leave these blank to disable the realtime connection. Never add an app secret.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=
NEXT_PUBLIC_REVERB_SCHEME=
# Use http for local ws connections or https for secure wss connections.
